# Anthropic API Key — get yours at console.anthropic.com
ANTHROPIC_API_KEY=

# App URL (set on Vercel automatically, or your domain)
NEXT_PUBLIC_APP_URL=

# Optional: restrict snippet CORS to specific domains
ALLOWED_ORIGINS=*

# Supabase — server-side (used by existing API routes, anon key, no RLS bypass)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase — browser/auth (used by @supabase/ssr for login sessions and
# middleware; NEXT_PUBLIC_ vars are exposed to the browser, same anon key
# as above, just under the names @supabase/ssr expects)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
